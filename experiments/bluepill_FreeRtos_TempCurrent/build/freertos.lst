 123:Core/Src/freertos.c **** /* USER CODE BEGIN Header_StartLogger */
 124:Core/Src/freertos.c **** /**
 125:Core/Src/freertos.c ****   * @brief  Function implementing the logger thread.
 126:Core/Src/freertos.c ****   * @param  argument: Not used
 127:Core/Src/freertos.c ****   * @retval None
 128:Core/Src/freertos.c ****   */
 129:Core/Src/freertos.c **** /* USER CODE END Header_StartLogger */
 130:Core/Src/freertos.c **** void StartLogger(void const * argument)
 131:Core/Src/freertos.c **** {
 132:Core/Src/freertos.c ****   /* USER CODE BEGIN StartLogger */
 133:Core/Src/freertos.c ****   printf("Iniciando Logger...\r\n");
 134:Core/Src/freertos.c ****   /* Infinite loop */
 135:Core/Src/freertos.c ****   uint32_t acumulador_temp = 0;
 136:Core/Src/freertos.c ****   uint32_t cuenta_muestras_temp = 0;
ARM GAS  /tmp/cc3sSiIy.s 			page 4


 137:Core/Src/freertos.c ****   float temp_filtrada = 0.0f;
 138:Core/Src/freertos.c ****   float corriente_actual = 0.0f;
 139:Core/Src/freertos.c **** 
 140:Core/Src/freertos.c ****   /* Infinite loop */
 141:Core/Src/freertos.c ****   for(;;)
 142:Core/Src/freertos.c ****   {
 143:Core/Src/freertos.c ****     if (buffer_listo) {
 144:Core/Src/freertos.c ****         // 1. PROCESAMOS LA CORRIENTE (Esto tarda microsegundos, no bloquea)
 145:Core/Src/freertos.c ****         corriente_actual = Procesar_Corriente_RMS();
 146:Core/Src/freertos.c ****         buffer_listo = 0; // Liberamos el buffer al toque
 147:Core/Src/freertos.c **** 
 148:Core/Src/freertos.c ****         // 2. TOMAMOS UNA SOLA MUESTRA DE TEMPERATURA
 149:Core/Src/freertos.c ****         // Como pasó 100ms desde la última vez, el capacitor interno está limpísimo (0 crosstal
 150:Core/Src/freertos.c ****         HAL_ADC_Start(&hadc2);
 151:Core/Src/freertos.c ****         if(HAL_ADC_PollForConversion(&hadc2, 2) == HAL_OK) {
 152:Core/Src/freertos.c ****             acumulador_temp += HAL_ADC_GetValue(&hadc2);
 153:Core/Src/freertos.c ****             cuenta_muestras_temp++;
 154:Core/Src/freertos.c ****         }
 155:Core/Src/freertos.c ****         HAL_ADC_Stop(&hadc2);
 156:Core/Src/freertos.c **** 
 157:Core/Src/freertos.c ****         // 3. ¿YA TENEMOS LAS 32 MUESTRAS? (Pasan cada ~3.2 segundos)
 158:Core/Src/freertos.c ****         if (cuenta_muestras_temp >= 32) {
 159:Core/Src/freertos.c ****             float promedio_ticks = (float)acumulador_temp / 32.0f;
 160:Core/Src/freertos.c ****             float voltaje_mv = promedio_ticks * (3262.0f / 4096.0f);
 161:Core/Src/freertos.c ****             temp_filtrada = voltaje_mv / 10.0f;
 162:Core/Src/freertos.c **** 
 163:Core/Src/freertos.c ****             // Reseteamos para el próximo ciclo largo
 164:Core/Src/freertos.c ****             acumulador_temp = 0;
 165:Core/Src/freertos.c ****             cuenta_muestras_temp = 0;
 166:Core/Src/freertos.c ****         }
 167:Core/Src/freertos.c **** 
 168:Core/Src/freertos.c ****         // 4. ENVIAMOS A PYTHON
 169:Core/Src/freertos.c ****         // Manda la corriente nueva siempre, y la temperatura se actualiza cada 3.2s
 170:Core/Src/freertos.c ****         printf("%.2f,%.2f\r\n", temp_filtrada, corriente_actual);
 171:Core/Src/freertos.c ****     } 
 172:Core/Src/freertos.c ****     
 173:Core/Src/freertos.c ****     vTaskDelay(pdMS_TO_TICKS(1));  
 174:Core/Src/freertos.c ****   }
 175:Core/Src/freertos.c ****   /* USER CODE END StartLogger */
 176:Core/Src/freertos.c **** }
