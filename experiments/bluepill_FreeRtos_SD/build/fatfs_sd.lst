 161:FATFS/App/fatfs_sd.c **** DRESULT SD_disk_ioctl(BYTE drv, BYTE ctrl, void *buff) {
 162:FATFS/App/fatfs_sd.c ****     DRESULT res = RES_ERROR;
 163:FATFS/App/fatfs_sd.c ****     BYTE n, csd[16];
 164:FATFS/App/fatfs_sd.c ****     DWORD csize;
 165:FATFS/App/fatfs_sd.c **** 
 166:FATFS/App/fatfs_sd.c ****     if (drv) return RES_PARERR;
 167:FATFS/App/fatfs_sd.c ****     if (Stat & STA_NOINIT) return RES_NOTRDY;
 168:FATFS/App/fatfs_sd.c **** 
 169:FATFS/App/fatfs_sd.c ****     SELECT();
 170:FATFS/App/fatfs_sd.c ****     switch (ctrl) {
 171:FATFS/App/fatfs_sd.c ****         case GET_SECTOR_COUNT:
 172:FATFS/App/fatfs_sd.c ****             if ((SD_SendCmd(CMD9, 0) == 0) && SD_RxDataBlock(csd, 16)) {
 173:FATFS/App/fatfs_sd.c ****                 if ((csd[0] >> 6) == 1) { // SDC Ver 2.00
 174:FATFS/App/fatfs_sd.c ****                     csize = csd[9] + ((WORD)csd[8] << 8) + ((DWORD)(csd[7] & 63) << 16) + 1;
 175:FATFS/App/fatfs_sd.c ****                     *(DWORD*)buff = csize << 10;
 176:FATFS/App/fatfs_sd.c ****                 } else { // SDC Ver 1.XX / MMC
 177:FATFS/App/fatfs_sd.c ****                     n = (csd[5] & 15) + ((csd[10] & 128) >> 7) + ((csd[9] & 3) << 1) + 2;
 178:FATFS/App/fatfs_sd.c ****                     csize = (csd[8] >> 6) + ((WORD)csd[7] << 2) + ((WORD)(csd[6] & 3) << 10) + 1;
 179:FATFS/App/fatfs_sd.c ****                     *(DWORD*)buff = csize << (n - 9);
 180:FATFS/App/fatfs_sd.c ****                 }
ARM GAS  /tmp/ccAVkzyz.s 			page 11


 181:FATFS/App/fatfs_sd.c ****                 res = RES_OK;
 182:FATFS/App/fatfs_sd.c ****             }
 183:FATFS/App/fatfs_sd.c ****             break;
 184:FATFS/App/fatfs_sd.c ****         case GET_SECTOR_SIZE: *(WORD*)buff = 512; res = RES_OK; break;
 185:FATFS/App/fatfs_sd.c ****         case CTRL_SYNC: if (SD_ReadyWait() == 0xFF) res = RES_OK; break;
 186:FATFS/App/fatfs_sd.c ****         default: res = RES_PARERR; break;
 187:FATFS/App/fatfs_sd.c ****     }
 188:FATFS/App/fatfs_sd.c ****     DESELECT();
 189:FATFS/App/fatfs_sd.c ****     SPI_RxByte();
 190:FATFS/App/fatfs_sd.c ****     return res;
 191:FATFS/App/fatfs_sd.c **** }
