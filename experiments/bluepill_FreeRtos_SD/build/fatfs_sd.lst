 114:FATFS/App/fatfs_sd.c **** DRESULT SD_disk_read(BYTE pdrv, BYTE* buff, DWORD sector, UINT count) {
 115:FATFS/App/fatfs_sd.c ****     if (pdrv || !count) return RES_PARERR;
 116:FATFS/App/fatfs_sd.c ****     if (Stat & STA_NOINIT) return RES_NOTRDY;
 117:FATFS/App/fatfs_sd.c **** 
 118:FATFS/App/fatfs_sd.c ****     if (!(CardType & 4)) sector *= 512; // Convertir a byte addressing si no es SDHC
 119:FATFS/App/fatfs_sd.c **** 
 120:FATFS/App/fatfs_sd.c ****     SELECT();
 121:FATFS/App/fatfs_sd.c ****     if (count == 1) {
 122:FATFS/App/fatfs_sd.c ****         if ((SD_SendCmd(CMD17, sector) == 0) && SD_RxDataBlock(buff, 512)) count = 0;
 123:FATFS/App/fatfs_sd.c ****     } else {
ARM GAS  /tmp/ccAVkzyz.s 			page 10


 124:FATFS/App/fatfs_sd.c ****         if (SD_SendCmd(CMD18, sector) == 0) {
 125:FATFS/App/fatfs_sd.c ****             do {
 126:FATFS/App/fatfs_sd.c ****                 if (!SD_RxDataBlock(buff, 512)) break;
 127:FATFS/App/fatfs_sd.c ****                 buff += 512;
 128:FATFS/App/fatfs_sd.c ****             } while (--count);
 129:FATFS/App/fatfs_sd.c ****             SD_SendCmd(CMD12, 0); // Stop Transmission
 130:FATFS/App/fatfs_sd.c ****         }
 131:FATFS/App/fatfs_sd.c ****     }
 132:FATFS/App/fatfs_sd.c ****     DESELECT();
 133:FATFS/App/fatfs_sd.c ****     SPI_RxByte();
 134:FATFS/App/fatfs_sd.c ****     return count ? RES_ERROR : RES_OK;
 135:FATFS/App/fatfs_sd.c **** }
 136:FATFS/App/fatfs_sd.c **** 
 137:FATFS/App/fatfs_sd.c **** DRESULT SD_disk_write(BYTE pdrv, const BYTE* buff, DWORD sector, UINT count) {
 138:FATFS/App/fatfs_sd.c ****     if (pdrv || !count) return RES_PARERR;
 139:FATFS/App/fatfs_sd.c ****     if (Stat & STA_NOINIT) return RES_NOTRDY;
 140:FATFS/App/fatfs_sd.c **** 
 141:FATFS/App/fatfs_sd.c ****     if (!(CardType & 4)) sector *= 512;
 142:FATFS/App/fatfs_sd.c **** 
 143:FATFS/App/fatfs_sd.c ****     SELECT();
 144:FATFS/App/fatfs_sd.c ****     if (count == 1) {
 145:FATFS/App/fatfs_sd.c ****         if ((SD_SendCmd(CMD24, sector) == 0) && SD_TxDataBlock(buff, 0xFE)) count = 0;
 146:FATFS/App/fatfs_sd.c ****     } else {
 147:FATFS/App/fatfs_sd.c ****         if (CardType & 2) { SD_SendCmd(CMD55, 0); SD_SendCmd(CMD23, count); }
 148:FATFS/App/fatfs_sd.c ****         if (SD_SendCmd(CMD25, sector) == 0) {
 149:FATFS/App/fatfs_sd.c ****             do {
 150:FATFS/App/fatfs_sd.c ****                 if(!SD_TxDataBlock(buff, 0xFC)) break;
 151:FATFS/App/fatfs_sd.c ****                 buff += 512;
 152:FATFS/App/fatfs_sd.c ****             } while (--count);
 153:FATFS/App/fatfs_sd.c ****             if(!SD_TxDataBlock(0, 0xFD)) count = 1;
 154:FATFS/App/fatfs_sd.c ****         }
 155:FATFS/App/fatfs_sd.c ****     }
 156:FATFS/App/fatfs_sd.c ****     DESELECT();
 157:FATFS/App/fatfs_sd.c ****     SPI_RxByte();
 158:FATFS/App/fatfs_sd.c ****     return count ? RES_ERROR : RES_OK;
 159:FATFS/App/fatfs_sd.c **** }
