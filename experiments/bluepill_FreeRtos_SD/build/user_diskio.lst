  31:FATFS/Target/user_diskio.c **** static uint8_t SPI_Xfer(uint8_t data) {
ARM GAS  /tmp/cclUZkff.s 			page 2


  32:FATFS/Target/user_diskio.c ****     uint8_t ret;
  33:FATFS/Target/user_diskio.c ****     HAL_SPI_TransmitReceive(&hspi1, &data, &ret, 1, 100);
  34:FATFS/Target/user_diskio.c ****     return ret;
  35:FATFS/Target/user_diskio.c **** }
  36:FATFS/Target/user_diskio.c **** 
  37:FATFS/Target/user_diskio.c **** static uint8_t SD_ReadyWait(void) {
  38:FATFS/Target/user_diskio.c ****     uint8_t res;
  39:FATFS/Target/user_diskio.c ****     uint32_t timeout = 50000;
  40:FATFS/Target/user_diskio.c ****     do {
  41:FATFS/Target/user_diskio.c ****         res = SPI_Xfer(0xFF);
  42:FATFS/Target/user_diskio.c ****     } while ((res != 0xFF) && --timeout);
  43:FATFS/Target/user_diskio.c ****     return res;
  44:FATFS/Target/user_diskio.c **** }
  45:FATFS/Target/user_diskio.c **** 
  46:FATFS/Target/user_diskio.c **** static uint8_t SD_SendCmd(uint8_t cmd, uint32_t arg) {
  47:FATFS/Target/user_diskio.c ****     uint8_t res, n;
  48:FATFS/Target/user_diskio.c **** 
  49:FATFS/Target/user_diskio.c ****     if (cmd & 0x80) { // ACMD
  50:FATFS/Target/user_diskio.c ****         cmd &= 0x7F;
  51:FATFS/Target/user_diskio.c ****         res = SD_SendCmd(CMD55, 0);
  52:FATFS/Target/user_diskio.c ****         if (res > 1) return res;
  53:FATFS/Target/user_diskio.c ****     }
  54:FATFS/Target/user_diskio.c **** 
  55:FATFS/Target/user_diskio.c ****     SD_CS_HIGH();
  56:FATFS/Target/user_diskio.c ****     SPI_Xfer(0xFF);
  57:FATFS/Target/user_diskio.c ****     SD_CS_LOW();
  58:FATFS/Target/user_diskio.c **** 
  59:FATFS/Target/user_diskio.c ****     if (SD_ReadyWait() != 0xFF) return 0xFF;
  60:FATFS/Target/user_diskio.c **** 
  61:FATFS/Target/user_diskio.c ****     SPI_Xfer(cmd | 0x40);
  62:FATFS/Target/user_diskio.c ****     SPI_Xfer(arg >> 24);
  63:FATFS/Target/user_diskio.c ****     SPI_Xfer(arg >> 16);
  64:FATFS/Target/user_diskio.c ****     SPI_Xfer(arg >> 8);
  65:FATFS/Target/user_diskio.c ****     SPI_Xfer(arg);
  66:FATFS/Target/user_diskio.c **** 
  67:FATFS/Target/user_diskio.c ****     n = 0x01;
  68:FATFS/Target/user_diskio.c ****     if (cmd == CMD0) n = 0x95;
  69:FATFS/Target/user_diskio.c ****     if (cmd == CMD8) n = 0x87;
  70:FATFS/Target/user_diskio.c ****     SPI_Xfer(n);
  71:FATFS/Target/user_diskio.c **** 
  72:FATFS/Target/user_diskio.c ****     n = 10;
  73:FATFS/Target/user_diskio.c ****     do {
  74:FATFS/Target/user_diskio.c ****         res = SPI_Xfer(0xFF);
  75:FATFS/Target/user_diskio.c ****     } while ((res & 0x80) && --n);
  76:FATFS/Target/user_diskio.c **** 
  77:FATFS/Target/user_diskio.c ****     return res;
  78:FATFS/Target/user_diskio.c **** }
  79:FATFS/Target/user_diskio.c **** /* USER CODE END DECL */
