  18:FATFS/Target/user_diskio.c **** 
  19:FATFS/Target/user_diskio.c **** #define SD_CS_LOW()  HAL_GPIO_WritePin(SD_CS_GPIO_Port, SD_CS_Pin, GPIO_PIN_RESET)
  20:FATFS/Target/user_diskio.c **** #define SD_CS_HIGH() HAL_GPIO_WritePin(SD_CS_GPIO_Port, SD_CS_Pin, GPIO_PIN_SET)
  21:FATFS/Target/user_diskio.c **** 
  22:FATFS/Target/user_diskio.c **** /* Comandos SD */
  23:FATFS/Target/user_diskio.c **** #define CMD0     (0)       /* GO_IDLE_STATE */
  24:FATFS/Target/user_diskio.c **** #define CMD8     (8)       /* SEND_IF_COND */
  25:FATFS/Target/user_diskio.c **** #define CMD55    (55)      /* APP_CMD */
  26:FATFS/Target/user_diskio.c **** #define ACMD41   (41)      /* SD_SEND_OP_COND */
