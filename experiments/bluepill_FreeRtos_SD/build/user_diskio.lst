 104:FATFS/Target/user_diskio.c **** DSTATUS USER_initialize (BYTE pdrv) {
 105:FATFS/Target/user_diskio.c ****   /* USER CODE BEGIN INIT */
 106:FATFS/Target/user_diskio.c ****     uint16_t i;
 107:FATFS/Target/user_diskio.c ****     uint8_t res;
 108:FATFS/Target/user_diskio.c **** 
 109:FATFS/Target/user_diskio.c ****     Stat = STA_NOINIT;
 110:FATFS/Target/user_diskio.c **** 
 111:FATFS/Target/user_diskio.c ****     // 1. Forzar velocidad lenta (Bajo los 400kHz requeridos por estándar)
 112:FATFS/Target/user_diskio.c ****     hspi1.Init.BaudRatePrescaler = SPI_BAUDRATEPRESCALER_128; 
 113:FATFS/Target/user_diskio.c ****     if (HAL_SPI_Init(&hspi1) != HAL_OK) return Stat;
 114:FATFS/Target/user_diskio.c **** 
 115:FATFS/Target/user_diskio.c ****     // 2. Despertar la tarjeta: CS en alto y enviar 80+ pulsos de reloj
 116:FATFS/Target/user_diskio.c ****     SD_CS_HIGH();
 117:FATFS/Target/user_diskio.c ****     osDelay(10); // Tiempo para que el voltaje se estabilice
 118:FATFS/Target/user_diskio.c ****     for (i = 0; i < 15; i++) SPI_Xfer(0xFF); 
 119:FATFS/Target/user_diskio.c **** 
 120:FATFS/Target/user_diskio.c ****     // 3. CMD0: Reset a la tarjeta (debe responder 0x01)
 121:FATFS/Target/user_diskio.c ****     i = 0;
 122:FATFS/Target/user_diskio.c ****     do {
 123:FATFS/Target/user_diskio.c ****         res = SD_SendCmd(CMD0, 0);
 124:FATFS/Target/user_diskio.c ****         osDelay(1);
 125:FATFS/Target/user_diskio.c ****     } while (res != 0x01 && ++i < 100);
 126:FATFS/Target/user_diskio.c **** 
 127:FATFS/Target/user_diskio.c ****     if (res == 0x01) {
 128:FATFS/Target/user_diskio.c ****         // 4. CMD8: Verificar voltaje (necesario para tarjetas SDHC/SDXC)
 129:FATFS/Target/user_diskio.c ****         if (SD_SendCmd(CMD8, 0x1AA) == 1) {
 130:FATFS/Target/user_diskio.c ****             for (i = 0; i < 4; i++) SPI_Xfer(0xFF); // Leer R7
 131:FATFS/Target/user_diskio.c ****             
 132:FATFS/Target/user_diskio.c ****             // 5. ACMD41: Inicialización operativa
 133:FATFS/Target/user_diskio.c ****             i = 1000;
 134:FATFS/Target/user_diskio.c ****             do {
 135:FATFS/Target/user_diskio.c ****                 res = SD_SendCmd(ACMD41, 0x40000000); // HCS bit set
 136:FATFS/Target/user_diskio.c ****                 osDelay(1);
 137:FATFS/Target/user_diskio.c ****             } while (res != 0x00 && --i);
 138:FATFS/Target/user_diskio.c ****             
 139:FATFS/Target/user_diskio.c ****             if (i > 0) {
 140:FATFS/Target/user_diskio.c ****                 // Éxito: Subir velocidad del SPI (Blue Pill 72MHz / 8 = 9MHz)
 141:FATFS/Target/user_diskio.c ****                 hspi1.Init.BaudRatePrescaler = SPI_BAUDRATEPRESCALER_8;
 142:FATFS/Target/user_diskio.c ****                 HAL_SPI_Init(&hspi1);
 143:FATFS/Target/user_diskio.c ****                 Stat &= ~STA_NOINIT;
 144:FATFS/Target/user_diskio.c ****                 printf("Tarjeta SD lista en modo SPI\r\n");
 145:FATFS/Target/user_diskio.c ****             }
ARM GAS  /tmp/cclUZkff.s 			page 4


 146:FATFS/Target/user_diskio.c ****         }
 147:FATFS/Target/user_diskio.c ****     }
 148:FATFS/Target/user_diskio.c ****     
 149:FATFS/Target/user_diskio.c ****     SD_CS_HIGH();
 150:FATFS/Target/user_diskio.c ****     SPI_Xfer(0xFF); // Ciclos extra para liberar el bus
 151:FATFS/Target/user_diskio.c ****     return Stat;
 152:FATFS/Target/user_diskio.c ****   /* USER CODE END INIT */
 153:FATFS/Target/user_diskio.c **** }
