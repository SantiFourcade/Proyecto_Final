 151:Core/Src/main.c **** int main(void)
 152:Core/Src/main.c **** {
 153:Core/Src/main.c ****   /* 1. Inicialización básica del sistema */
ARM GAS  /tmp/ccN1vgZ6.s 			page 6


 154:Core/Src/main.c ****   HAL_Init();
 155:Core/Src/main.c ****   SystemClock_Config(); // Configurado a 32MHz para sincronizar con el emisor
 156:Core/Src/main.c **** 
 157:Core/Src/main.c ****   /* 2. Reloj de AFIO para el remap de pines PB8/PB9 */
 158:Core/Src/main.c ****   __HAL_RCC_AFIO_CLK_ENABLE();
 159:Core/Src/main.c **** 
 160:Core/Src/main.c ****   /* 3. Inicialización de periféricos de hardware */
 161:Core/Src/main.c ****   MX_GPIO_Init();
 162:Core/Src/main.c ****   MX_USART1_UART_Init();
 163:Core/Src/main.c ****   
 164:Core/Src/main.c ****   /* Imprimimos el inicio una vez que la UART está lista */
 165:Core/Src/main.c ****   printf("\r\n=== RECEPTOR MANTENIMIENTO PREDICTIVO ===\r\n");
 166:Core/Src/main.c **** 
 167:Core/Src/main.c ****   /* 4. Configuración del CAN (Debe estar en CAN_MODE_NORMAL en can.c) */
 168:Core/Src/main.c ****   MX_CAN_Init();
 169:Core/Src/main.c ****   CAN_Filter_Init(); // Filtro abierto para recibir RMS, PEAK, etc.
 170:Core/Src/main.c **** 
 171:Core/Src/main.c ****   /* 5. Inicializar objetos de FreeRTOS (Crea la cola canRxQueue) */
 172:Core/Src/main.c ****   /* Es vital que esto ocurra ANTES de activar las interrupciones del CAN */
 173:Core/Src/main.c ****   MX_FREERTOS_Init();
 174:Core/Src/main.c **** 
 175:Core/Src/main.c ****   /* 6. Arrancar el periférico CAN y activar notificaciones */
 176:Core/Src/main.c ****   if (HAL_CAN_Start(&hcan) == HAL_OK)
 177:Core/Src/main.c ****   {
 178:Core/Src/main.c ****       printf("CAN Iniciado correctamente en Modo Normal\r\n");
 179:Core/Src/main.c ****       
 180:Core/Src/main.c ****       /* Activamos la interrupción de recepción para el FIFO 0 */
 181:Core/Src/main.c ****       HAL_CAN_ActivateNotification(&hcan, CAN_IT_RX_FIFO0_MSG_PENDING | CAN_IT_ERROR);
 182:Core/Src/main.c ****       
 183:Core/Src/main.c ****       uint32_t state = HAL_CAN_GetState(&hcan);
 184:Core/Src/main.c ****       printf("Estado inicial del bus: %ld\r\n", state);
 185:Core/Src/main.c ****   }
 186:Core/Src/main.c ****   else
 187:Core/Src/main.c ****   {
 188:Core/Src/main.c ****       printf("Error crítico: No se pudo arrancar el CAN\r\n");
 189:Core/Src/main.c ****       Error_Handler();
 190:Core/Src/main.c ****   }
 191:Core/Src/main.c **** 
 192:Core/Src/main.c ****   /* 7. Iniciar el Scheduler de FreeRTOS */
 193:Core/Src/main.c ****   /* A partir de aquí, la tarea CAN_Rx_Task tomará el control de los datos */
 194:Core/Src/main.c ****   osKernelStart();
 195:Core/Src/main.c **** 
 196:Core/Src/main.c ****   /* El sistema no debería llegar nunca a este punto */
 197:Core/Src/main.c ****   while (1);
 198:Core/Src/main.c **** }
