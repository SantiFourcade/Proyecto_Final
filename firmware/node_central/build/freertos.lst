 126:Core/Src/freertos.c ****                           label, rxMsg.header.StdId, canValue);
 127:Core/Src/freertos.c ****                   // Formatear línea CSV
 128:Core/Src/freertos.c ****                   int len = sprintf(buffer, "%lu,%s,0x%03lX,%.3f\n", 
 129:Core/Src/freertos.c ****                                     osKernelSysTick(), label, rxMsg.header.StdId, canValue);
 130:Core/Src/freertos.c **** 
 131:Core/Src/freertos.c ****                   // 4. Escribir en la SD
 132:Core/Src/freertos.c ****                   res = f_write(&file, buffer, len, &bw);
 133:Core/Src/freertos.c ****                   
 134:Core/Src/freertos.c ****                   if (res == FR_OK) {
 135:Core/Src/freertos.c ****                       // Sincronizar cada 10 mensajes para no saturar el bus SPI
