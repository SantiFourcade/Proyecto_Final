 113:Core/Src/freertos.c ****               /* 3. Bloquear la tarea hasta recibir un mensaje CAN */
 114:Core/Src/freertos.c ****               if (xQueueReceive(canRxQueueSD, &rxMsg, portMAX_DELAY) == pdPASS) {
 115:Core/Src/freertos.c ****                   
 116:Core/Src/freertos.c ****                   // Extraer el valor float de los datos CAN
