 132:FATFS/App/fatfs_sd.c **** /* 데이터 패킷 수신 */
 133:FATFS/App/fatfs_sd.c **** static bool SD_RxDataBlock(BYTE *buff, UINT btr) 
 134:FATFS/App/fatfs_sd.c **** {
 135:FATFS/App/fatfs_sd.c ****   uint8_t token;
 136:FATFS/App/fatfs_sd.c ****   
 137:FATFS/App/fatfs_sd.c ****   /* 100ms 타이머 */
 138:FATFS/App/fatfs_sd.c ****   Timer1 = 100;
 139:FATFS/App/fatfs_sd.c ****   
 140:FATFS/App/fatfs_sd.c ****   /* 응답 대기 */		
 141:FATFS/App/fatfs_sd.c ****   do 
 142:FATFS/App/fatfs_sd.c ****   {    
 143:FATFS/App/fatfs_sd.c ****     token = SPI_RxByte();
 144:FATFS/App/fatfs_sd.c ****   } while((token == 0xFF) && Timer1);
 145:FATFS/App/fatfs_sd.c ****   
 146:FATFS/App/fatfs_sd.c ****   /* 0xFE 이외 Token 수신 시 에러 처리 */
 147:FATFS/App/fatfs_sd.c ****   if(token != 0xFE)
 148:FATFS/App/fatfs_sd.c ****     return FALSE;
 149:FATFS/App/fatfs_sd.c ****   
 150:FATFS/App/fatfs_sd.c ****   /* 버퍼에 데이터 수신 */
 151:FATFS/App/fatfs_sd.c ****   while(btr--) 
 152:FATFS/App/fatfs_sd.c ****   {     
 153:FATFS/App/fatfs_sd.c ****     SPI_RxBytePtr(buff++);
ARM GAS  /tmp/cc260XQy.s 			page 13


 154:FATFS/App/fatfs_sd.c ****   }
 155:FATFS/App/fatfs_sd.c ****   
 156:FATFS/App/fatfs_sd.c ****   SPI_RxByte(); /* CRC 무시 */
 157:FATFS/App/fatfs_sd.c ****   SPI_RxByte();
 158:FATFS/App/fatfs_sd.c ****   
 159:FATFS/App/fatfs_sd.c ****   return TRUE;
 160:FATFS/App/fatfs_sd.c **** }
