  39:FATFS/App/fatfs_sd.c **** /* SPI 데이터 송수신 리턴형 함수 */
  40:FATFS/App/fatfs_sd.c **** static uint8_t SPI_RxByte(void)
  41:FATFS/App/fatfs_sd.c **** {
  42:FATFS/App/fatfs_sd.c ****   uint8_t dummy, data;
  43:FATFS/App/fatfs_sd.c ****   dummy = 0xFF;
  44:FATFS/App/fatfs_sd.c ****   data = 0;
  45:FATFS/App/fatfs_sd.c ****   
  46:FATFS/App/fatfs_sd.c ****   while ((HAL_SPI_GetState(&hspi1) != HAL_SPI_STATE_READY));
  47:FATFS/App/fatfs_sd.c ****   HAL_SPI_TransmitReceive(&hspi1, &dummy, &data, 1, SPI_TIMEOUT);
  48:FATFS/App/fatfs_sd.c ****   
  49:FATFS/App/fatfs_sd.c ****   return data;
  50:FATFS/App/fatfs_sd.c **** }
  51:FATFS/App/fatfs_sd.c **** 
  52:FATFS/App/fatfs_sd.c **** /* SPI 데이터 송수신 포인터형 함수 */
