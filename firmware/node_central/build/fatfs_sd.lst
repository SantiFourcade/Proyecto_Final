 282:FATFS/App/fatfs_sd.c ****   /* Idle 상태 진입 */
 283:FATFS/App/fatfs_sd.c ****   if (SD_SendCmd(CMD0, 0) == 1) 
 284:FATFS/App/fatfs_sd.c ****   { 
 285:FATFS/App/fatfs_sd.c ****     /* 타이머 1초 설정 */
 286:FATFS/App/fatfs_sd.c ****     Timer1 = 1000;
 287:FATFS/App/fatfs_sd.c ****     
 288:FATFS/App/fatfs_sd.c ****     /* SD 인터페이스 동작 조건 확인 */
 289:FATFS/App/fatfs_sd.c ****     if (SD_SendCmd(CMD8, 0x1AA) == 1) 
 290:FATFS/App/fatfs_sd.c ****     { 
 291:FATFS/App/fatfs_sd.c ****       /* SDC Ver2+ */
 292:FATFS/App/fatfs_sd.c ****       for (n = 0; n < 4; n++)
 293:FATFS/App/fatfs_sd.c ****       {
 294:FATFS/App/fatfs_sd.c ****         ocr[n] = SPI_RxByte();
ARM GAS  /tmp/cc260XQy.s 			page 25


 295:FATFS/App/fatfs_sd.c ****       }
 296:FATFS/App/fatfs_sd.c ****       
 297:FATFS/App/fatfs_sd.c ****       if (ocr[2] == 0x01 && ocr[3] == 0xAA) 
 298:FATFS/App/fatfs_sd.c ****       { 
 299:FATFS/App/fatfs_sd.c ****         /* 2.7-3.6V 전압범위 동작 */
 300:FATFS/App/fatfs_sd.c ****         do {
 301:FATFS/App/fatfs_sd.c ****           if (SD_SendCmd(CMD55, 0) <= 1 && SD_SendCmd(CMD41, 1UL << 30) == 0)
 302:FATFS/App/fatfs_sd.c ****             break; /* ACMD41 with HCS bit */
 303:FATFS/App/fatfs_sd.c ****         } while (Timer1);
 304:FATFS/App/fatfs_sd.c ****         
 305:FATFS/App/fatfs_sd.c ****         if (Timer1 && SD_SendCmd(CMD58, 0) == 0) 
 306:FATFS/App/fatfs_sd.c ****         { 
 307:FATFS/App/fatfs_sd.c ****           /* Check CCS bit */
 308:FATFS/App/fatfs_sd.c ****           for (n = 0; n < 4; n++)
 309:FATFS/App/fatfs_sd.c ****           {
 310:FATFS/App/fatfs_sd.c ****             ocr[n] = SPI_RxByte();
 311:FATFS/App/fatfs_sd.c ****           }
 312:FATFS/App/fatfs_sd.c ****           
 313:FATFS/App/fatfs_sd.c ****           type = (ocr[0] & 0x40) ? 6 : 2;
 314:FATFS/App/fatfs_sd.c ****         }
 315:FATFS/App/fatfs_sd.c ****       }
 316:FATFS/App/fatfs_sd.c ****     } 
 317:FATFS/App/fatfs_sd.c ****     else 
 318:FATFS/App/fatfs_sd.c ****     { 
 319:FATFS/App/fatfs_sd.c ****       /* SDC Ver1 or MMC */
 320:FATFS/App/fatfs_sd.c ****       type = (SD_SendCmd(CMD55, 0) <= 1 && SD_SendCmd(CMD41, 0) <= 1) ? 2 : 1; /* SDC : MMC */
 321:FATFS/App/fatfs_sd.c ****       
 322:FATFS/App/fatfs_sd.c ****       do {
 323:FATFS/App/fatfs_sd.c ****         if (type == 2) 
 324:FATFS/App/fatfs_sd.c ****         {
 325:FATFS/App/fatfs_sd.c ****           if (SD_SendCmd(CMD55, 0) <= 1 && SD_SendCmd(CMD41, 0) == 0)
 326:FATFS/App/fatfs_sd.c ****             break; /* ACMD41 */
 327:FATFS/App/fatfs_sd.c ****         } 
 328:FATFS/App/fatfs_sd.c ****         else 
 329:FATFS/App/fatfs_sd.c ****         {
 330:FATFS/App/fatfs_sd.c ****           if (SD_SendCmd(CMD1, 0) == 0)
 331:FATFS/App/fatfs_sd.c ****             break; /* CMD1 */
 332:FATFS/App/fatfs_sd.c ****         }
 333:FATFS/App/fatfs_sd.c ****       } while (Timer1);
 334:FATFS/App/fatfs_sd.c ****       
 335:FATFS/App/fatfs_sd.c ****       if (!Timer1 || SD_SendCmd(CMD16, 512) != 0) 
 336:FATFS/App/fatfs_sd.c ****       {
 337:FATFS/App/fatfs_sd.c ****         /* 블럭 길이 선택 */
 338:FATFS/App/fatfs_sd.c ****         type = 0;
 339:FATFS/App/fatfs_sd.c ****       }
 340:FATFS/App/fatfs_sd.c ****     }
 341:FATFS/App/fatfs_sd.c ****   }
