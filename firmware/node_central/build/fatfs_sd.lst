  58:FATFS/App/fatfs_sd.c **** /* SD카드 Ready 대기 */
  59:FATFS/App/fatfs_sd.c **** static uint8_t SD_ReadyWait(void) 
  60:FATFS/App/fatfs_sd.c **** {
  61:FATFS/App/fatfs_sd.c ****   uint8_t res;
  62:FATFS/App/fatfs_sd.c ****   
  63:FATFS/App/fatfs_sd.c ****   /* 500ms 카운터 준비 */
  64:FATFS/App/fatfs_sd.c ****   Timer2 = 500;
  65:FATFS/App/fatfs_sd.c ****   SPI_RxByte();
  66:FATFS/App/fatfs_sd.c ****   
  67:FATFS/App/fatfs_sd.c ****   do
  68:FATFS/App/fatfs_sd.c ****   {
  69:FATFS/App/fatfs_sd.c ****     /* 0xFF 값이 수신될 때 까지 SPI 통신 */
  70:FATFS/App/fatfs_sd.c ****     res = SPI_RxByte();
  71:FATFS/App/fatfs_sd.c ****   } while ((res != 0xFF) && Timer2);
  72:FATFS/App/fatfs_sd.c ****   
  73:FATFS/App/fatfs_sd.c ****   return res;
  74:FATFS/App/fatfs_sd.c **** }
  75:FATFS/App/fatfs_sd.c **** 
  76:FATFS/App/fatfs_sd.c **** /* 전원 켜기 */
  77:FATFS/App/fatfs_sd.c **** static void SD_PowerOn(void) 
  78:FATFS/App/fatfs_sd.c **** {
  79:FATFS/App/fatfs_sd.c ****   uint8_t cmd_arg[6];
  80:FATFS/App/fatfs_sd.c ****   uint32_t Count = 0x1FFF;
  81:FATFS/App/fatfs_sd.c ****   
  82:FATFS/App/fatfs_sd.c ****   /* Deselect 상태에서 SPI 메시지를 전송하여 대기상태로 만든다. */
  83:FATFS/App/fatfs_sd.c ****   DESELECT();
  84:FATFS/App/fatfs_sd.c ****   
  85:FATFS/App/fatfs_sd.c ****   for(int i = 0; i < 10; i++)
  86:FATFS/App/fatfs_sd.c ****   {
  87:FATFS/App/fatfs_sd.c ****     SPI_TxByte(0xFF);
  88:FATFS/App/fatfs_sd.c ****   }
  89:FATFS/App/fatfs_sd.c ****   
  90:FATFS/App/fatfs_sd.c ****   /* SPI Chips Select */
ARM GAS  /tmp/cc260XQy.s 			page 3


  91:FATFS/App/fatfs_sd.c ****   SELECT();
  92:FATFS/App/fatfs_sd.c ****   
  93:FATFS/App/fatfs_sd.c ****   /* 초기 GO_IDLE_STATE 상태 전환 */
  94:FATFS/App/fatfs_sd.c ****   cmd_arg[0] = (CMD0 | 0x40);
  95:FATFS/App/fatfs_sd.c ****   cmd_arg[1] = 0;
  96:FATFS/App/fatfs_sd.c ****   cmd_arg[2] = 0;
  97:FATFS/App/fatfs_sd.c ****   cmd_arg[3] = 0;
  98:FATFS/App/fatfs_sd.c ****   cmd_arg[4] = 0;
  99:FATFS/App/fatfs_sd.c ****   cmd_arg[5] = 0x95;
 100:FATFS/App/fatfs_sd.c ****   
 101:FATFS/App/fatfs_sd.c ****   /* 명령 전송 */
 102:FATFS/App/fatfs_sd.c ****   for (int i = 0; i < 6; i++)
 103:FATFS/App/fatfs_sd.c ****   {
 104:FATFS/App/fatfs_sd.c ****     SPI_TxByte(cmd_arg[i]);
 105:FATFS/App/fatfs_sd.c ****   }
 106:FATFS/App/fatfs_sd.c ****   
 107:FATFS/App/fatfs_sd.c ****   /* 응답 대기 */
 108:FATFS/App/fatfs_sd.c ****   while ((SPI_RxByte() != 0x01) && Count)
 109:FATFS/App/fatfs_sd.c ****   {
 110:FATFS/App/fatfs_sd.c ****     Count--;
 111:FATFS/App/fatfs_sd.c ****   }
 112:FATFS/App/fatfs_sd.c ****   
 113:FATFS/App/fatfs_sd.c ****   DESELECT();
 114:FATFS/App/fatfs_sd.c ****   SPI_TxByte(0XFF);
 115:FATFS/App/fatfs_sd.c ****   
 116:FATFS/App/fatfs_sd.c ****   PowerFlag = 1;
 117:FATFS/App/fatfs_sd.c **** }
