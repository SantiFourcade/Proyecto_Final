 162:FATFS/App/fatfs_sd.c **** /* 데이터 전송 패킷 */
 163:FATFS/App/fatfs_sd.c **** #if _READONLY == 0
 164:FATFS/App/fatfs_sd.c **** static bool SD_TxDataBlock(const BYTE *buff, BYTE token)
 165:FATFS/App/fatfs_sd.c **** {
 166:FATFS/App/fatfs_sd.c ****   uint8_t resp = 0xFF, i = 0;  /* resp 초기화 */
 167:FATFS/App/fatfs_sd.c ****   uint16_t wc;
 168:FATFS/App/fatfs_sd.c ****     
 169:FATFS/App/fatfs_sd.c ****   /* SD카드 준비 대기 */
 170:FATFS/App/fatfs_sd.c ****   if (SD_ReadyWait() != 0xFF)
 171:FATFS/App/fatfs_sd.c ****     return FALSE;
 172:FATFS/App/fatfs_sd.c ****   
 173:FATFS/App/fatfs_sd.c ****   /* 토큰 전송 */
 174:FATFS/App/fatfs_sd.c ****   SPI_TxByte(token);      
 175:FATFS/App/fatfs_sd.c ****   
 176:FATFS/App/fatfs_sd.c ****   /* 데이터 토큰인 경우 */
 177:FATFS/App/fatfs_sd.c ****   if (token != 0xFD) 
 178:FATFS/App/fatfs_sd.c ****   { 
 179:FATFS/App/fatfs_sd.c ****     wc = 512;
 180:FATFS/App/fatfs_sd.c ****     
 181:FATFS/App/fatfs_sd.c ****     /* 512 바이트 데이터 전송 */
 182:FATFS/App/fatfs_sd.c ****     while(wc--) 
 183:FATFS/App/fatfs_sd.c ****     { 
 184:FATFS/App/fatfs_sd.c ****       SPI_TxByte(*buff++);
 185:FATFS/App/fatfs_sd.c ****     }
 186:FATFS/App/fatfs_sd.c ****     
 187:FATFS/App/fatfs_sd.c ****     SPI_RxByte();       /* CRC 무시 */
 188:FATFS/App/fatfs_sd.c ****     SPI_RxByte();
 189:FATFS/App/fatfs_sd.c ****     
 190:FATFS/App/fatfs_sd.c ****     /* 데이트 응답 수신 */        
 191:FATFS/App/fatfs_sd.c ****     while (i <= 64) 
 192:FATFS/App/fatfs_sd.c ****     {			
 193:FATFS/App/fatfs_sd.c ****       resp = SPI_RxByte();
 194:FATFS/App/fatfs_sd.c ****       
 195:FATFS/App/fatfs_sd.c ****       /* 에러 응답 처리 */
 196:FATFS/App/fatfs_sd.c ****       if ((resp & 0x1F) == 0x05) 
 197:FATFS/App/fatfs_sd.c ****         break;
 198:FATFS/App/fatfs_sd.c ****       
 199:FATFS/App/fatfs_sd.c ****       i++;
 200:FATFS/App/fatfs_sd.c ****     }
 201:FATFS/App/fatfs_sd.c ****     
 202:FATFS/App/fatfs_sd.c ****     /* SPI 수신 버퍼 Clear - 타임아웃 추가 */
 203:FATFS/App/fatfs_sd.c ****     Timer1 = 200; /* 200ms 타임아웃 */
 204:FATFS/App/fatfs_sd.c ****     while (SPI_RxByte() == 0 && Timer1);
 205:FATFS/App/fatfs_sd.c ****   }
 206:FATFS/App/fatfs_sd.c ****   
 207:FATFS/App/fatfs_sd.c ****   if ((resp & 0x1F) == 0x05)
 208:FATFS/App/fatfs_sd.c ****     return TRUE;
 209:FATFS/App/fatfs_sd.c ****   else
 210:FATFS/App/fatfs_sd.c ****     return FALSE;
ARM GAS  /tmp/cc260XQy.s 			page 14


 211:FATFS/App/fatfs_sd.c **** }
