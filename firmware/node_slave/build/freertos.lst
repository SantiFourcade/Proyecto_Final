 199:Core/Src/freertos.c **** /**
 200:Core/Src/freertos.c ****  * @brief Calcula la corriente RMS centrando la señal con el offset calibrado.
 201:Core/Src/freertos.c ****  * @retval Valor de corriente eficaz en Voltios (basado en VREF de 3.262V).
 202:Core/Src/freertos.c ****  */
 203:Core/Src/freertos.c **** float Procesar_Corriente_RMS(void) {
 204:Core/Src/freertos.c ****     float suma_cuadrados = 0.0f;        
 205:Core/Src/freertos.c ****     
 206:Core/Src/freertos.c ****     for(int i = 0; i < 100; i++) {
 207:Core/Src/freertos.c ****         // Restamos offset usando tus 3.262V reales (1.631V = 2048 ticks)
 208:Core/Src/freertos.c ****         int32_t centrado = (int32_t)adc_buffer_corriente[i] - 2048;
 209:Core/Src/freertos.c ****         suma_cuadrados += (float)(centrado * centrado);
 210:Core/Src/freertos.c ****     }
 211:Core/Src/freertos.c ****     
 212:Core/Src/freertos.c ****     float rms_raw = sqrtf(suma_cuadrados / 100.0f);
 213:Core/Src/freertos.c ****     return (rms_raw * (3.262f / 4096.0f)); 
 214:Core/Src/freertos.c **** }
 215:Core/Src/freertos.c **** 
 216:Core/Src/freertos.c **** float temp_filtrada = 0.0f;
 217:Core/Src/freertos.c **** float corriente_actual = 0.0f;
 218:Core/Src/freertos.c **** 
 219:Core/Src/freertos.c **** void StartAcquireTask(void const * argument)
 220:Core/Src/freertos.c **** {
 221:Core/Src/freertos.c ****     printf("Iniciando Adquisidor...\r\n");
 222:Core/Src/freertos.c ****     uint32_t acumulador_temp = 0;
 223:Core/Src/freertos.c ****     uint32_t cuenta_muestras_temp = 0;
 224:Core/Src/freertos.c **** 
 225:Core/Src/freertos.c ****     static raw_data_t raw;
 226:Core/Src/freertos.c ****     uint16_t idx = 0;
 227:Core/Src/freertos.c **** 
 228:Core/Src/freertos.c ****     /* Variables para velocidad */
 229:Core/Src/freertos.c ****     static uint32_t acumulador_ticks = 0;
 230:Core/Src/freertos.c ****     static uint8_t contador_pulsos = 0;
 231:Core/Src/freertos.c ****     float rpm = 0.0f;
 232:Core/Src/freertos.c **** 
 233:Core/Src/freertos.c ****     for(;;)
 234:Core/Src/freertos.c ****     {    
 235:Core/Src/freertos.c ****         // ACELERÓMETRO
 236:Core/Src/freertos.c ****         ADXL345_ReadXYZ(&raw.accel.ax[idx],
 237:Core/Src/freertos.c ****                         &raw.accel.ay[idx],
 238:Core/Src/freertos.c ****                         &raw.accel.az[idx]);
 239:Core/Src/freertos.c ****         // printf("%d,%d,%d\r\n",
 240:Core/Src/freertos.c ****         //     raw.accel.ax[idx],
 241:Core/Src/freertos.c ****         //     raw.accel.ay[idx],
ARM GAS  /tmp/ccIsR5z6.s 			page 7


 242:Core/Src/freertos.c ****         //     raw.accel.az[idx]);
 243:Core/Src/freertos.c ****         if (new_read)
 244:Core/Src/freertos.c ****         {
 245:Core/Src/freertos.c ****             taskENTER_CRITICAL();
 246:Core/Src/freertos.c ****             uint32_t current_ticks = diff_ticks;
 247:Core/Src/freertos.c ****             new_read = 0;
 248:Core/Src/freertos.c ****             taskEXIT_CRITICAL();
 249:Core/Src/freertos.c **** 
 250:Core/Src/freertos.c ****             acumulador_ticks += current_ticks;
 251:Core/Src/freertos.c ****             contador_pulsos++;
 252:Core/Src/freertos.c **** 
 253:Core/Src/freertos.c ****             if (contador_pulsos >= 8)
 254:Core/Src/freertos.c ****             {
 255:Core/Src/freertos.c ****                 float promedio_ticks = (float)acumulador_ticks / 8.0f;
 256:Core/Src/freertos.c **** 
 257:Core/Src/freertos.c ****                 /* Fórmula RPM */
 258:Core/Src/freertos.c ****                 rpm = 7500000.0f / promedio_ticks;
 259:Core/Src/freertos.c **** 
 260:Core/Src/freertos.c ****                 acumulador_ticks = 0;
 261:Core/Src/freertos.c ****                 contador_pulsos = 0;
 262:Core/Src/freertos.c **** 
 263:Core/Src/freertos.c ****             }
 264:Core/Src/freertos.c ****         }
 265:Core/Src/freertos.c **** 
 266:Core/Src/freertos.c ****         raw.speed = rpm;
 267:Core/Src/freertos.c **** 
 268:Core/Src/freertos.c ****         if (buffer_listo) {
 269:Core/Src/freertos.c ****             corriente_actual = Procesar_Corriente_RMS();
 270:Core/Src/freertos.c ****             buffer_listo = 0;
 271:Core/Src/freertos.c **** 
 272:Core/Src/freertos.c ****             HAL_ADC_Start(&hadc2);
 273:Core/Src/freertos.c ****             if(HAL_ADC_PollForConversion(&hadc2, 2) == HAL_OK) {
 274:Core/Src/freertos.c ****                 acumulador_temp += HAL_ADC_GetValue(&hadc2);
 275:Core/Src/freertos.c ****                 cuenta_muestras_temp++;
 276:Core/Src/freertos.c ****             }
 277:Core/Src/freertos.c ****             HAL_ADC_Stop(&hadc2);
 278:Core/Src/freertos.c **** 
 279:Core/Src/freertos.c ****             if (cuenta_muestras_temp >= 32) {
 280:Core/Src/freertos.c ****                 float promedio_ticks = (float)acumulador_temp / 32.0f;
 281:Core/Src/freertos.c ****                 float voltaje_mv = promedio_ticks * (3262.0f / 4096.0f);
