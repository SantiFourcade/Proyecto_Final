 291:Core/Src/freertos.c **** /* ============================================================
 292:Core/Src/freertos.c ****  * StartTelemetryTask
 293:Core/Src/freertos.c ****  * Maneja RPM (pulsos) y telemetría lenta (ADC2 temperatura).
 294:Core/Src/freertos.c ****  * ============================================================ */
 295:Core/Src/freertos.c **** void StartTelemetryTask(void const * argument)
 296:Core/Src/freertos.c **** {
 297:Core/Src/freertos.c ****     printf("Iniciando Telemetría Lenta (ADC2 / RPM)...\r\n");
 298:Core/Src/freertos.c **** 
 299:Core/Src/freertos.c ****     uint32_t acumulador_temp      = 0;
 300:Core/Src/freertos.c ****     uint32_t cuenta_muestras_temp = 0;
 301:Core/Src/freertos.c ****     uint32_t acumulador_ticks     = 0;
 302:Core/Src/freertos.c ****     uint8_t  contador_pulsos      = 0;
 303:Core/Src/freertos.c **** 
 304:Core/Src/freertos.c ****     for (;;)
 305:Core/Src/freertos.c ****     {
 306:Core/Src/freertos.c ****         /* --------------------------------------------------
 307:Core/Src/freertos.c ****          * 1. RPM — [FIX-2] Lectura y limpieza atómica de new_read
 308:Core/Src/freertos.c ****          * -------------------------------------------------- */
 309:Core/Src/freertos.c ****         uint8_t hubo_pulso;
 310:Core/Src/freertos.c ****         static TickType_t ultimo_pulso = 0;
 311:Core/Src/freertos.c ****         uint32_t ticks_capturados;
 312:Core/Src/freertos.c **** 
 313:Core/Src/freertos.c ****         taskENTER_CRITICAL();
 314:Core/Src/freertos.c ****         hubo_pulso = new_read;
 315:Core/Src/freertos.c ****         if (hubo_pulso)
 316:Core/Src/freertos.c ****         {
 317:Core/Src/freertos.c ****             ticks_capturados = diff_ticks;
 318:Core/Src/freertos.c ****             new_read = 0;          /* limpieza dentro de la misma sección crítica */
 319:Core/Src/freertos.c ****         }
 320:Core/Src/freertos.c ****         taskEXIT_CRITICAL();
 321:Core/Src/freertos.c **** 
 322:Core/Src/freertos.c ****         if (hubo_pulso)
 323:Core/Src/freertos.c ****         {
 324:Core/Src/freertos.c ****             ultimo_pulso = xTaskGetTickCount();
 325:Core/Src/freertos.c ****             acumulador_ticks += ticks_capturados;
 326:Core/Src/freertos.c ****             contador_pulsos++;
 327:Core/Src/freertos.c **** 
 328:Core/Src/freertos.c ****             if (contador_pulsos >= 8)
 329:Core/Src/freertos.c ****             {
 330:Core/Src/freertos.c ****                 float promedio = (float)acumulador_ticks / 8.0f;
 331:Core/Src/freertos.c ****                 /* [FIX-1] escritura segura */
 332:Core/Src/freertos.c ****                 Telemetry_SetRPM(7500000.0f / promedio);
 333:Core/Src/freertos.c ****                 acumulador_ticks = 0;
 334:Core/Src/freertos.c ****                 contador_pulsos  = 0;
 335:Core/Src/freertos.c ****             }
 336:Core/Src/freertos.c ****         }
 337:Core/Src/freertos.c ****         if ((xTaskGetTickCount() - ultimo_pulso) > pdMS_TO_TICKS(1000)) {
 338:Core/Src/freertos.c ****             Telemetry_SetRPM(0.0f);
 339:Core/Src/freertos.c ****         }
 340:Core/Src/freertos.c **** 
 341:Core/Src/freertos.c ****         /* --------------------------------------------------
 342:Core/Src/freertos.c ****          * 2. Corriente + Temperatura — [FIX-2] ídem para buffer_listo
 343:Core/Src/freertos.c ****          * -------------------------------------------------- */
 344:Core/Src/freertos.c ****         uint8_t buffer_disponible;
 345:Core/Src/freertos.c **** 
 346:Core/Src/freertos.c ****         taskENTER_CRITICAL();
 347:Core/Src/freertos.c ****         buffer_disponible = buffer_listo;
ARM GAS  /tmp/ccfmOoCP.s 			page 13


 348:Core/Src/freertos.c ****         if (buffer_disponible)
 349:Core/Src/freertos.c ****             buffer_listo = 0;   /* limpieza atómica */
 350:Core/Src/freertos.c ****         taskEXIT_CRITICAL();
 351:Core/Src/freertos.c **** 
 352:Core/Src/freertos.c ****         if (buffer_disponible)
 353:Core/Src/freertos.c ****         {
 354:Core/Src/freertos.c ****             /* [FIX-1] escritura segura de corriente */
 355:Core/Src/freertos.c ****             Telemetry_SetCurrent(Procesar_Corriente_RMS());
 356:Core/Src/freertos.c **** 
 357:Core/Src/freertos.c ****             HAL_ADC_Start(&hadc2);
 358:Core/Src/freertos.c ****             if (HAL_ADC_PollForConversion(&hadc2, 2) == HAL_OK)
 359:Core/Src/freertos.c ****             {
 360:Core/Src/freertos.c ****                 acumulador_temp += HAL_ADC_GetValue(&hadc2);
 361:Core/Src/freertos.c ****                 cuenta_muestras_temp++;
 362:Core/Src/freertos.c ****             }
 363:Core/Src/freertos.c ****             HAL_ADC_Stop(&hadc2);
 364:Core/Src/freertos.c **** 
 365:Core/Src/freertos.c ****             if (cuenta_muestras_temp >= 32)
 366:Core/Src/freertos.c ****             {
 367:Core/Src/freertos.c ****                 float promedio_adc = (float)acumulador_temp / 32.0f;
 368:Core/Src/freertos.c ****                 float voltaje_mv   = promedio_adc * (3262.0f / 4096.0f);
 369:Core/Src/freertos.c ****                 /* [FIX-1] escritura segura de temperatura */
 370:Core/Src/freertos.c ****                 Telemetry_SetTemp(voltaje_mv / 10.0f);
 371:Core/Src/freertos.c **** 
 372:Core/Src/freertos.c ****                 acumulador_temp      = 0;
 373:Core/Src/freertos.c ****                 cuenta_muestras_temp = 0;
 374:Core/Src/freertos.c ****             }
 375:Core/Src/freertos.c ****         }
 376:Core/Src/freertos.c **** 
 377:Core/Src/freertos.c ****         vTaskDelay(pdMS_TO_TICKS(20));
 378:Core/Src/freertos.c ****     }
 379:Core/Src/freertos.c **** }
