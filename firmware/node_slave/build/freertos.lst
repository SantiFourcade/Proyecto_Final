 247:Core/Src/freertos.c **** /**
 248:Core/Src/freertos.c ****  * @brief Calcula la corriente RMS centrando la señal con el offset calibrado.
 249:Core/Src/freertos.c ****  * @retval Valor de corriente eficaz en Voltios (basado en VREF de 3.262V).
 250:Core/Src/freertos.c ****  */
 251:Core/Src/freertos.c **** float Procesar_Corriente_RMS(void) {
 252:Core/Src/freertos.c ****     float suma_cuadrados = 0.0f;        
 253:Core/Src/freertos.c ****     
 254:Core/Src/freertos.c ****     for(int i = 0; i < 100; i++) {
 255:Core/Src/freertos.c ****         // Restamos offset usando tus 3.262V reales (1.631V = 2048 ticks)
 256:Core/Src/freertos.c ****         int32_t centrado = (int32_t)adc_buffer_corriente[i] - 2048;
 257:Core/Src/freertos.c ****         suma_cuadrados += (float)(centrado * centrado);
 258:Core/Src/freertos.c ****     }
ARM GAS  /tmp/ccjkNbhh.s 			page 7


 259:Core/Src/freertos.c ****     
 260:Core/Src/freertos.c ****     float rms_raw = sqrtf(suma_cuadrados / 100.0f);
 261:Core/Src/freertos.c ****     return (rms_raw * (3.262f / 4096.0f)); 
 262:Core/Src/freertos.c **** }
 263:Core/Src/freertos.c **** 
 264:Core/Src/freertos.c **** float temp_filtrada = 0.0f;
 265:Core/Src/freertos.c **** float corriente_actual = 0.0f;
