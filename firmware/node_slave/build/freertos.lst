 299:Core/Src/freertos.c ****             acumulador_temp      = 0;
 300:Core/Src/freertos.c ****             cuenta_muestras_temp = 0;
 301:Core/Src/freertos.c ****             acumulador_ticks     = 0;
 302:Core/Src/freertos.c ****             contador_pulsos      = 0;
 303:Core/Src/freertos.c ****             Telemetry_SetRPM(0.0f);
 304:Core/Src/freertos.c ****             estaba_activo        = 0;
 305:Core/Src/freertos.c **** 
 306:Core/Src/freertos.c ****             vTaskDelay(pdMS_TO_TICKS(20));
 307:Core/Src/freertos.c ****             continue;
 308:Core/Src/freertos.c ****         }
 309:Core/Src/freertos.c **** 
 310:Core/Src/freertos.c ****         if (!estaba_activo)
 311:Core/Src/freertos.c ****         {
 312:Core/Src/freertos.c ****             ultimo_pulso = xTaskGetTickCount();
 313:Core/Src/freertos.c ****             taskENTER_CRITICAL();
 314:Core/Src/freertos.c ****             new_read = 0;
 315:Core/Src/freertos.c ****             taskEXIT_CRITICAL();
 316:Core/Src/freertos.c ****             estaba_activo = 1;
 317:Core/Src/freertos.c ****         }
 318:Core/Src/freertos.c **** 
 319:Core/Src/freertos.c ****         uint8_t hubo_pulso;
 320:Core/Src/freertos.c ****         uint32_t ticks_capturados;
 321:Core/Src/freertos.c **** 
 322:Core/Src/freertos.c ****         taskENTER_CRITICAL();
 323:Core/Src/freertos.c ****         hubo_pulso = new_read;
 324:Core/Src/freertos.c ****         if (hubo_pulso)
 325:Core/Src/freertos.c ****         {
 326:Core/Src/freertos.c ****             ticks_capturados = diff_ticks;
 327:Core/Src/freertos.c ****             new_read = 0;
 328:Core/Src/freertos.c ****         }
 329:Core/Src/freertos.c ****         taskEXIT_CRITICAL();
 330:Core/Src/freertos.c **** 
 331:Core/Src/freertos.c ****         if (hubo_pulso)
 332:Core/Src/freertos.c ****         {
 333:Core/Src/freertos.c ****             ultimo_pulso = xTaskGetTickCount();
 334:Core/Src/freertos.c ****             acumulador_ticks += ticks_capturados;
 335:Core/Src/freertos.c ****             contador_pulsos++;
 336:Core/Src/freertos.c **** 
