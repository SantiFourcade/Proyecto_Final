 285:Core/Src/freertos.c ****     printf("Iniciando Telemetría Lenta (ADC2 / RPM)...\r\n");
 286:Core/Src/freertos.c **** 
 287:Core/Src/freertos.c ****     uint32_t acumulador_temp      = 0;
 288:Core/Src/freertos.c ****     uint32_t cuenta_muestras_temp = 0;
