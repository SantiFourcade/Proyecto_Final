 157:Core/Src/freertos.c ****     /* Sampler – Alta prioridad, dispara ADC1 cada 1 ms */
 158:Core/Src/freertos.c ****     osThreadDef(sampler, StartSampler, osPriorityHigh, 0, 128);
 159:Core/Src/freertos.c ****     samplerHandle = osThreadCreate(osThread(sampler), NULL);
 160:Core/Src/freertos.c **** 
 161:Core/Src/freertos.c ****     /* Accel – I2C exclusivo, 50 Hz */
 162:Core/Src/freertos.c ****     osThreadDef(accelTask, StartAccelTask, osPriorityNormal, 0, 512);
 163:Core/Src/freertos.c ****     accelHandle = osThreadCreate(osThread(accelTask), NULL);
 164:Core/Src/freertos.c **** 
 165:Core/Src/freertos.c ****     /* Telemetry – ADC2 polling + RPM, prioridad baja */
 166:Core/Src/freertos.c ****     osThreadDef(telemetryTask, StartTelemetryTask, osPriorityBelowNormal, 0, 256);
 167:Core/Src/freertos.c ****     telemetryHandle = osThreadCreate(osThread(telemetryTask), NULL);
 168:Core/Src/freertos.c **** 
 169:Core/Src/freertos.c ****     /* Package – Procesamiento matemático */
 170:Core/Src/freertos.c ****     osThreadDef(package, StartPackageTask, osPriorityNormal, 0, 256);
 171:Core/Src/freertos.c ****     packageHandle = osThreadCreate(osThread(package), NULL);
 172:Core/Src/freertos.c **** 
 173:Core/Src/freertos.c ****     /* TxCAN – Despacho de tramas */
 174:Core/Src/freertos.c ****     osThreadDef(txCAN, StartTxCAN, osPriorityNormal, 0, 512);
 175:Core/Src/freertos.c ****     txCANHandle = osThreadCreate(osThread(txCAN), NULL);
 176:Core/Src/freertos.c **** }
