 341:Core/Src/freertos.c ****                 acumulador_ticks = 0;
 342:Core/Src/freertos.c ****                 contador_pulsos  = 0;
 343:Core/Src/freertos.c ****             }
 344:Core/Src/freertos.c ****         }
 345:Core/Src/freertos.c ****         if ((xTaskGetTickCount() - ultimo_pulso) > pdMS_TO_TICKS(1000)) {
 346:Core/Src/freertos.c ****             Telemetry_SetRPM(0.0f);
 347:Core/Src/freertos.c ****         }
 348:Core/Src/freertos.c **** 
