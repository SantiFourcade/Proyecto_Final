  40:FATFS/App/fatfs_sd.c **** /* Función tipo retorno para envío y recepción SPI */
  41:FATFS/App/fatfs_sd.c **** static uint8_t SPI_RxByte(void)
  42:FATFS/App/fatfs_sd.c **** {
  43:FATFS/App/fatfs_sd.c ****   uint8_t dummy, data;
  44:FATFS/App/fatfs_sd.c ****   dummy = 0xFF;
  45:FATFS/App/fatfs_sd.c ****   data = 0;
  46:FATFS/App/fatfs_sd.c **** 
  47:FATFS/App/fatfs_sd.c ****   while ((HAL_SPI_GetState(&hspi1) != HAL_SPI_STATE_READY))
  48:FATFS/App/fatfs_sd.c ****     ;
  49:FATFS/App/fatfs_sd.c ****   HAL_SPI_TransmitReceive(&hspi1, &dummy, &data, 1, SPI_TIMEOUT);
  50:FATFS/App/fatfs_sd.c **** 
  51:FATFS/App/fatfs_sd.c ****   return data;
  52:FATFS/App/fatfs_sd.c **** }
  53:FATFS/App/fatfs_sd.c **** 
  54:FATFS/App/fatfs_sd.c **** /* Función de tipo puntero para envío y recepción SPI */
  55:FATFS/App/fatfs_sd.c **** static void SPI_RxBytePtr(uint8_t *buff)
  56:FATFS/App/fatfs_sd.c **** {
  57:FATFS/App/fatfs_sd.c ****   *buff = SPI_RxByte();
  58:FATFS/App/fatfs_sd.c **** }
  59:FATFS/App/fatfs_sd.c **** 
  60:FATFS/App/fatfs_sd.c **** /* Espera de SD Card Ready (Lista) */
  61:FATFS/App/fatfs_sd.c **** static uint8_t SD_ReadyWait(void)
  62:FATFS/App/fatfs_sd.c **** {
  63:FATFS/App/fatfs_sd.c ****   uint8_t res;
  64:FATFS/App/fatfs_sd.c **** 
  65:FATFS/App/fatfs_sd.c ****   Timer2 = 500;
  66:FATFS/App/fatfs_sd.c ****   SPI_RxByte();
  67:FATFS/App/fatfs_sd.c **** 
  68:FATFS/App/fatfs_sd.c ****   do
  69:FATFS/App/fatfs_sd.c ****   {
  70:FATFS/App/fatfs_sd.c ****     // Comunicación SPI hasta que se reciba el valor 0xFF
  71:FATFS/App/fatfs_sd.c ****     res = SPI_RxByte();
  72:FATFS/App/fatfs_sd.c ****   } while ((res != 0xFF) && Timer2);
  73:FATFS/App/fatfs_sd.c **** 
  74:FATFS/App/fatfs_sd.c ****   return res;
  75:FATFS/App/fatfs_sd.c **** }
  76:FATFS/App/fatfs_sd.c **** 
  77:FATFS/App/fatfs_sd.c **** /* Encendido */
  78:FATFS/App/fatfs_sd.c **** static void SD_PowerOn(void)
  79:FATFS/App/fatfs_sd.c **** {
  80:FATFS/App/fatfs_sd.c ****   uint8_t cmd_arg[6];
  81:FATFS/App/fatfs_sd.c ****   uint32_t Count = 0x1FFF;
  82:FATFS/App/fatfs_sd.c **** 
  83:FATFS/App/fatfs_sd.c ****   // Envía un mensaje SPI en estado Deselect (deseleccionado) para ponerlo en modo de espera (stan
  84:FATFS/App/fatfs_sd.c ****   DESELECT();
  85:FATFS/App/fatfs_sd.c **** 
  86:FATFS/App/fatfs_sd.c ****   for (int i = 0; i < 10; i++)
  87:FATFS/App/fatfs_sd.c ****   {
  88:FATFS/App/fatfs_sd.c ****     SPI_TxByte(0xFF);
  89:FATFS/App/fatfs_sd.c ****   }
  90:FATFS/App/fatfs_sd.c **** 
ARM GAS  /tmp/cc8LcH9P.s 			page 3


  91:FATFS/App/fatfs_sd.c ****   // SPI Chips Select 
  92:FATFS/App/fatfs_sd.c ****   SELECT();
  93:FATFS/App/fatfs_sd.c **** 
  94:FATFS/App/fatfs_sd.c ****   // Transicion al estado GO_IDLE_STATE
  95:FATFS/App/fatfs_sd.c ****   cmd_arg[0] = (CMD0 | 0x40);
  96:FATFS/App/fatfs_sd.c ****   cmd_arg[1] = 0;
  97:FATFS/App/fatfs_sd.c ****   cmd_arg[2] = 0;
  98:FATFS/App/fatfs_sd.c ****   cmd_arg[3] = 0;
  99:FATFS/App/fatfs_sd.c ****   cmd_arg[4] = 0;
 100:FATFS/App/fatfs_sd.c ****   cmd_arg[5] = 0x95;
 101:FATFS/App/fatfs_sd.c **** 
 102:FATFS/App/fatfs_sd.c ****   // Envío de comando
 103:FATFS/App/fatfs_sd.c ****   for (int i = 0; i < 6; i++)
 104:FATFS/App/fatfs_sd.c ****   {
 105:FATFS/App/fatfs_sd.c ****     SPI_TxByte(cmd_arg[i]);
 106:FATFS/App/fatfs_sd.c ****   }
 107:FATFS/App/fatfs_sd.c **** 
 108:FATFS/App/fatfs_sd.c ****   // Espera de respuesta
 109:FATFS/App/fatfs_sd.c ****   while ((SPI_RxByte() != 0x01) && Count)
 110:FATFS/App/fatfs_sd.c ****   {
 111:FATFS/App/fatfs_sd.c ****     Count--;
 112:FATFS/App/fatfs_sd.c ****   }
 113:FATFS/App/fatfs_sd.c **** 
 114:FATFS/App/fatfs_sd.c ****   DESELECT();
 115:FATFS/App/fatfs_sd.c ****   SPI_TxByte(0XFF);
 116:FATFS/App/fatfs_sd.c **** 
 117:FATFS/App/fatfs_sd.c ****   PowerFlag = 1;
 118:FATFS/App/fatfs_sd.c **** }
