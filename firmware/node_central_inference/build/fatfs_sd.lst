 278:FATFS/App/fatfs_sd.c **** 
 279:FATFS/App/fatfs_sd.c ****   // Entrada al estado Idle
 280:FATFS/App/fatfs_sd.c ****   if (SD_SendCmd(CMD0, 0) == 1)
 281:FATFS/App/fatfs_sd.c ****   {
 282:FATFS/App/fatfs_sd.c **** 
 283:FATFS/App/fatfs_sd.c ****     Timer1 = 1000;
 284:FATFS/App/fatfs_sd.c **** 
 285:FATFS/App/fatfs_sd.c ****     // Verificación de las condiciones de funcionamiento de la interfaz SD
 286:FATFS/App/fatfs_sd.c ****     if (SD_SendCmd(CMD8, 0x1AA) == 1)
 287:FATFS/App/fatfs_sd.c ****     {
 288:FATFS/App/fatfs_sd.c ****       // SDC Ver2+
 289:FATFS/App/fatfs_sd.c ****       for (n = 0; n < 4; n++)
 290:FATFS/App/fatfs_sd.c ****       {
 291:FATFS/App/fatfs_sd.c ****         ocr[n] = SPI_RxByte();
ARM GAS  /tmp/cc8LcH9P.s 			page 25


 292:FATFS/App/fatfs_sd.c ****       }
 293:FATFS/App/fatfs_sd.c **** 
 294:FATFS/App/fatfs_sd.c ****       if (ocr[2] == 0x01 && ocr[3] == 0xAA)
 295:FATFS/App/fatfs_sd.c ****       {
 296:FATFS/App/fatfs_sd.c ****         // Rango de voltaje de operación entre 2.7 y 3.6V
 297:FATFS/App/fatfs_sd.c ****         do
 298:FATFS/App/fatfs_sd.c ****         {
 299:FATFS/App/fatfs_sd.c ****           if (SD_SendCmd(CMD55, 0) <= 1 && SD_SendCmd(CMD41, 1UL << 30) == 0)
 300:FATFS/App/fatfs_sd.c ****             break; // ACMD41 with HCS bit
 301:FATFS/App/fatfs_sd.c ****         } while (Timer1);
 302:FATFS/App/fatfs_sd.c **** 
 303:FATFS/App/fatfs_sd.c ****         if (Timer1 && SD_SendCmd(CMD58, 0) == 0)
 304:FATFS/App/fatfs_sd.c ****         {
 305:FATFS/App/fatfs_sd.c ****           // Check CCS bit
 306:FATFS/App/fatfs_sd.c ****           for (n = 0; n < 4; n++)
 307:FATFS/App/fatfs_sd.c ****           {
 308:FATFS/App/fatfs_sd.c ****             ocr[n] = SPI_RxByte();
 309:FATFS/App/fatfs_sd.c ****           }
 310:FATFS/App/fatfs_sd.c **** 
 311:FATFS/App/fatfs_sd.c ****           type = (ocr[0] & 0x40) ? 6 : 2;
 312:FATFS/App/fatfs_sd.c ****         }
 313:FATFS/App/fatfs_sd.c ****       }
 314:FATFS/App/fatfs_sd.c ****     }
 315:FATFS/App/fatfs_sd.c ****     else
 316:FATFS/App/fatfs_sd.c ****     {
 317:FATFS/App/fatfs_sd.c ****       // SDC Ver1 or MMC
 318:FATFS/App/fatfs_sd.c ****       type = (SD_SendCmd(CMD55, 0) <= 1 && SD_SendCmd(CMD41, 0) <= 1) ? 2 : 1; /* SDC : MMC */
 319:FATFS/App/fatfs_sd.c **** 
 320:FATFS/App/fatfs_sd.c ****       do
 321:FATFS/App/fatfs_sd.c ****       {
 322:FATFS/App/fatfs_sd.c ****         if (type == 2)
 323:FATFS/App/fatfs_sd.c ****         {
 324:FATFS/App/fatfs_sd.c ****           if (SD_SendCmd(CMD55, 0) <= 1 && SD_SendCmd(CMD41, 0) == 0)
 325:FATFS/App/fatfs_sd.c ****             break; // ACMD41 
 326:FATFS/App/fatfs_sd.c ****         }
 327:FATFS/App/fatfs_sd.c ****         else
 328:FATFS/App/fatfs_sd.c ****         {
 329:FATFS/App/fatfs_sd.c ****           if (SD_SendCmd(CMD1, 0) == 0)
 330:FATFS/App/fatfs_sd.c ****             break; // CMD1
 331:FATFS/App/fatfs_sd.c ****         }
 332:FATFS/App/fatfs_sd.c ****       } while (Timer1);
 333:FATFS/App/fatfs_sd.c **** 
 334:FATFS/App/fatfs_sd.c ****       if (!Timer1 || SD_SendCmd(CMD16, 512) != 0)
 335:FATFS/App/fatfs_sd.c ****       {
 336:FATFS/App/fatfs_sd.c ****         // Selección de la longitud del bloque
 337:FATFS/App/fatfs_sd.c ****         type = 0;
 338:FATFS/App/fatfs_sd.c ****       }
 339:FATFS/App/fatfs_sd.c ****     }
 340:FATFS/App/fatfs_sd.c ****   }
