 171:FATFS/App/fatfs_sd.c ****     return FALSE;
 172:FATFS/App/fatfs_sd.c **** 
 173:FATFS/App/fatfs_sd.c ****   // Envío de token
 174:FATFS/App/fatfs_sd.c ****   SPI_TxByte(token);
 175:FATFS/App/fatfs_sd.c **** 
 176:FATFS/App/fatfs_sd.c ****   // En caso de ser un token de datos
 177:FATFS/App/fatfs_sd.c ****   if (token != 0xFD)
 178:FATFS/App/fatfs_sd.c ****   {
 179:FATFS/App/fatfs_sd.c ****     wc = 512;
 180:FATFS/App/fatfs_sd.c **** 
 181:FATFS/App/fatfs_sd.c ****     // Transferencia de datos de 512 bytes
 182:FATFS/App/fatfs_sd.c ****     while (wc--)
 183:FATFS/App/fatfs_sd.c ****     {
 184:FATFS/App/fatfs_sd.c ****       SPI_TxByte(*buff++);
 185:FATFS/App/fatfs_sd.c ****     }
 186:FATFS/App/fatfs_sd.c **** 
 187:FATFS/App/fatfs_sd.c ****     SPI_RxByte(); // Ignorar CRC
 188:FATFS/App/fatfs_sd.c ****     SPI_RxByte();
 189:FATFS/App/fatfs_sd.c **** 
 190:FATFS/App/fatfs_sd.c ****     // Recepción de respuesta de datos
